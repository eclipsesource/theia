{
  "name": "theia-tauri-webview-probe",
  "displayName": "Theia Tauri Webview Probe",
  "version": "0.0.1",
  "publisher": "theia",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./main.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tauriProbe.openWebview",
        "title": "Tauri Probe: Open Webview"
      },
      {
        "command": "tauriProbe.secrets",
        "title": "Tauri Probe: Test Secret Storage"
      },
      {
        "command": "tauriProbe.persistSecret",
        "title": "Tauri Probe: Store Secret For Relaunch"
      },
      {
        "command": "tauriProbe.openCustomEditor",
        "title": "Tauri Probe: Open Custom Editor"
      },
      {
        "command": "tauriProbe.saveDialog",
        "title": "Tauri Probe: Test Save Dialog"
      },
      {
        "command": "tauriProbe.openView",
        "title": "Tauri Probe: Open View"
      }
    ],
    "customEditors": [
      {
        "viewType": "tauriProbe.customEditor",
        "displayName": "Tauri Probe Custom Editor",
        "selector": [
          {
            "filenamePattern": "*.tauri-probe"
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tauriProbe.sidebar",
          "name": "Tauri Probe View",
          "type": "webview"
        }
      ]
    }
  }
}
